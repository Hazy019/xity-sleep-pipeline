# ============================================================
# Modern Stoic Pipeline — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# --- LLM (FREE — get key from https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Google OAuth2 (YouTube + Drive + Analytics) ---
# Download OAuth2 Desktop credentials JSON from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Required APIs to enable:
#   - YouTube Data API v3
#   - Google Drive API
#   - YouTube Analytics API
# Leave the values below as-is — the credentials.json path is used directly by the code.
# Place your downloaded file at: config/credentials.json

# Your YouTube Channel ID (found in YouTube Studio > Settings > Channel > Advanced)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Discord Webhook URLs ---
# Create webhooks in Discord: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_QUEUE=https://discord.com/api/webhooks/xxx/xxx
DISCORD_WEBHOOK_LOGS=https://discord.com/api/webhooks/xxx/xxx
DISCORD_WEBHOOK_ERRORS=https://discord.com/api/webhooks/xxx/xxx
DISCORD_WEBHOOK_POSTS=https://discord.com/api/webhooks/xxx/xxx
DISCORD_WEBHOOK_INSIGHTS=https://discord.com/api/webhooks/xxx/xxx

# Your Discord User ID (enable Developer Mode in Discord, right-click your name > Copy ID)
DISCORD_KYRELL_USER_ID=your_discord_user_id_here

# --- Optional: Pre-created GDrive Folder ID ---
# If blank, the pipeline auto-creates an "XitySleepBible" folder on first run.
GDRIVE_FOLDER_ID=

# --- Background Video from Google Drive ---
# Set this to the Drive File ID of your background .mp4 video.
# The pipeline will auto-download it if the local file is missing.
# Find the file ID in the Google Drive share link:
# Example: https://drive.google.com/file/d/THIS_IS_THE_ID/view
GDRIVE_VIDEO_ID=

# --- SFX / Ambient Music from Google Drive ---
# The background ambient audio track (e.g. 432hz brown noise) stored in Drive.
GDRIVE_SFX_ID=

# --- Resume Support: Set these manually if re-running from step 7+ ---
GDRIVE_LONG_VIDEO_ID=
GDRIVE_SHORT_VIDEO_ID=
