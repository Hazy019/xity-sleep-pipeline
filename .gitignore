# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
.eggs/
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Environment variables — NEVER commit
.env

# Google OAuth tokens — contains refresh tokens, never commit
config/token_drive.json
config/token_youtube.json
config/token_analytics.json
config/master_token.json

# Google OAuth credentials — contains client secret, never commit
config/credentials.json

# Generated pipeline outputs — too large for version control
outputs/
logs/
scratch/
archive/
*.log

# Assets — too large for git, synced from GDrive
assets/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo